-- ================================================================
--  Fish It! — Database/Replion Scan Debug
--  Cari RemoteFunction dan data listing player di ReplicatedStorage
-- ================================================================

local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local Workspace          = game:GetService("Workspace")
local lp                 = Players.LocalPlayer

print("=== DATABASE SCAN DEBUG ===")

-- ──────────────────────────────
-- 1. Scan ReplicatedStorage untuk RemoteFunction dan RemoteEvent
-- ──────────────────────────────
print("\n[1] RemoteFunction di ReplicatedStorage:")
local rfCount = 0
for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
    if d:IsA("RemoteFunction") then
        rfCount = rfCount + 1
        print(("  RF: %s"):format(d:GetFullName()))
    end
end
if rfCount == 0 then print("  (tidak ada RemoteFunction)") end

print("\n[2] RemoteEvent di ReplicatedStorage (yang namanya relevan):")
for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
    if d:IsA("RemoteEvent") then
        local nl = d.Name:lower()
        if nl:find("list") or nl:find("booth") or nl:find("market") or nl:find("sell")
            or nl:find("shop") or nl:find("item") or nl:find("trade") or nl:find("plaza") then
            print(("  RE: %s"):format(d:GetFullName()))
        end
    end
end

-- ──────────────────────────────
-- 2. Cari Replion / Replica di ReplicatedStorage
-- ──────────────────────────────
print("\n[3] Replion / Replica folders di ReplicatedStorage:")
local function printChildren(inst, depth)
    if depth > 4 then return end
    for _, ch in ipairs(inst:GetChildren()) do
        local nl = ch.Name:lower()
        if nl:find("repli") or nl:find("data") or nl:find("player") or nl:find("list")
            or nl:find("booth") or nl:find("market") or nl:find("item") then
            print(string.rep("  ", depth) .. "[" .. ch.ClassName .. "] " .. ch.Name)
            printChildren(ch, depth + 1)
        end
    end
end
printChildren(ReplicatedStorage, 1)

-- ──────────────────────────────
-- 3. Cek folder di bawah Players[username]
-- ──────────────────────────────
print("\n[4] Folder/Value di Players[username]:")
for _, plr in ipairs(Players:GetPlayers()) do
    local children = plr:GetChildren()
    if #children > 0 then
        print(("  Player: %s"):format(plr.Name))
        for _, ch in ipairs(children) do
            print(("    [%s] %s"):format(ch.ClassName, ch.Name))
            -- Cek sub-children juga
            for _, gc in ipairs(ch:GetChildren()) do
                print(("      [%s] %s"):format(gc.ClassName, gc.Name))
            end
        end
    end
end

-- ──────────────────────────────
-- 4. Cek PlayerGui: ada GUI yang menyimpan listing data semua player?
-- ──────────────────────────────
print("\n[5] PlayerGui ScreenGuis yang mungkin punya data listing:")
if lp:FindFirstChild("PlayerGui") then
    for _, d in ipairs(lp.PlayerGui:GetDescendants()) do
        local nl = d.Name:lower()
        if d:IsA("Frame") or d:IsA("ScrollingFrame") then
            if nl:find("list") or nl:find("booth") or nl:find("market") or nl:find("sell")
                or nl:find("item") or nl:find("trade") then
                print(("  [PG] %s [%s]"):format(d.Name, d.ClassName))
                -- Print semua text labels di dalamnya
                for _, ch in ipairs(d:GetDescendants()) do
                    if (ch:IsA("TextLabel") or ch:IsA("TextButton")) and ch.Text ~= "" then
                        print(("    Label '%s': %s"):format(ch.Name, ch.Text:sub(1,50)))
                    end
                end
            end
        end
    end
end

-- ──────────────────────────────
-- 5. Coba invoke RemoteFunction yang paling relevan
-- ──────────────────────────────
print("\n[6] Coba invoke RemoteFunction yang ada (max 5):")
local tried = 0
for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
    if d:IsA("RemoteFunction") and tried < 5 then
        tried = tried + 1
        local ok, res = pcall(function()
            return d:InvokeServer()
        end)
        if ok and res ~= nil then
            local t = type(res)
            print(("  [OK] %s → type:%s"):format(d:GetFullName(), t))
            if t == "table" then
                for k, v in pairs(res) do
                    print(("    key=%s type=%s"):format(tostring(k):sub(1,20), type(v)))
                    if type(v) == "table" then
                        for k2, v2 in pairs(v) do
                            print(("      %s = %s"):format(tostring(k2):sub(1,20), tostring(v2):sub(1,40)))
                        end
                    end
                end
            end
        else
            print(("  [ERR] %s → %s"):format(d:GetFullName(), tostring(res):sub(1,50)))
        end
    end
end

-- ──────────────────────────────
-- 6. Cek apakah ada Replion module
-- ──────────────────────────────
print("\n[7] Cari Replion module:")
local function findReplion(root, depth)
    if depth > 3 then return end
    for _, ch in ipairs(root:GetChildren()) do
        if ch:IsA("ModuleScript") then
            local nl = ch.Name:lower()
            if nl:find("repli") or nl == "replion" or nl:find("replica") then
                print(("  [MODULE] %s"):format(ch:GetFullName()))
            end
        end
        findReplion(ch, depth + 1)
    end
end
findReplion(ReplicatedStorage, 0)
findReplion(game:GetService("Players").LocalPlayer, 0)

print("\n=== SELESAI — Share hasilnya ===")
