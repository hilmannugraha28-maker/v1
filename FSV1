    end
    RunService.Heartbeat:Wait()
    Scroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    StatsText.Text = string.format("%d items | %d snipes", #entries, snipeCount)
    if snipeCount > 0 then BubbleBadge.Visible = true; BubbleBadge.Text = tostring(snipeCount)
    else BubbleBadge.Visible = false end
end

-- ==========================
-- SORT & FILTER
-- ==========================
local function ApplySortAndFilter()
    local sq = SearchBox.Text:lower()
    local filtered = {}
    for _, entry in ipairs(allEntries) do
        if snipeOnlyEnabled and not IsSnipe(entry.Price, entry.RAP) then continue end
        local nameOk = sq == "" or (entry.ItemName and entry.ItemName:lower():find(sq, 1, true))
        local typeOk = sq == "" or (entry.ItemType and entry.ItemType:lower():find(sq, 1, true))
        local sellOk = sq == "" or (entry.SellerName and entry.SellerName:lower():find(sq, 1, true))
        if nameOk or typeOk or sellOk then table.insert(filtered, entry) end
    end
    local mode = currentSortIdx
    table.sort(filtered, function(a, b)
        if mode == 1 then return (a.Price or 0) < (b.Price or 0)
        elseif mode == 2 then return (a.RAP or 0) > (b.RAP or 0)
        elseif mode == 3 then
            local aS, bS = IsSnipe(a.Price, a.RAP), IsSnipe(b.Price, b.RAP)
            if aS ~= bS then return aS end
            if aS then return ((a.RAP or 0) - (a.Price or 0)) > ((b.RAP or 0) - (b.Price or 0)) end
            return (a.Price or 0) < (b.Price or 0)
        elseif mode == 4 then
            local ap = (a.RAP and a.RAP > 0) and (a.RAP - (a.Price or 0)) or -999999
            local bp = (b.RAP and b.RAP > 0) and (b.RAP - (b.Price or 0)) or -999999
            return ap > bp
        end
        return (a.Price or 0) < (b.Price or 0)
    end)
    RenderItems(filtered)
end

