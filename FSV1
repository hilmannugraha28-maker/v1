--  Fish It! — Replion Data Scanner
--  Baca data listing player dari Replion replication system
-- ================================================================

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local lp                = Players.LocalPlayer

print("=== REPLION DATA SCAN ===")

-- ──────────────────────────────
-- 1. Load Replion
-- ──────────────────────────────
local Replion
local ok, err = pcall(function()
    Replion = require(ReplicatedStorage.Packages.Replion)
end)

if not ok or not Replion then
    print("[ERR] Replion gagal load: " .. tostring(err))
else
    print("[OK] Replion loaded, type: " .. type(Replion))

    -- Print semua method/field yang ada
    if type(Replion) == "table" then
        print("  Replion methods:")
        for k, v in pairs(Replion) do
            print(("    .%s = %s"):format(tostring(k), type(v)))
        end
    end

    -- Coba akses Replion dengan berbagai cara
    local methods = { "GetReplion", "WaitForReplion", "get", "Get", "find", "Find" }
    for _, method in ipairs(methods) do
        if type(Replion[method]) == "function" then
            print("\n  [FOUND] Replion." .. method .. " exists!")
            -- Coba dengan nama yang mungkin terkait listings
            local testNames = {
                "PlayerData", "Player", "Booth", "Listing", "Listings",
                "Market", "Trade", "Plaza", "Shop", "Inventory",
                "BoothData", "MarketData", "TradePlaza",
            }
            for _, name in ipairs(testNames) do
                local ok2, result = pcall(function()
                    return Replion[method](Replion, name)
                end)
                if ok2 and result then
                    print(("    Replion.%s('%s') → %s"):format(method, name, type(result)))
                    if type(result) == "table" then
                        for k, v in pairs(result) do
                            print(("      [%s] = %s"):format(tostring(k):sub(1,30), type(v)))
                        end
                    end
                end
            end
        end
    end
end

