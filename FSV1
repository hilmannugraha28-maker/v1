-- ──────────────────────────────
-- 4. Scan Workspace untuk data listing (folder lain selain Booths/Leaderboard)
-- ──────────────────────────────
print("\n[4] Folder lain di TradePlaza:")
local tradePlaza
for _, d in ipairs(Workspace:GetDescendants()) do
    if d.Name == "TradePlaza" then tradePlaza = d; break end
end

if tradePlaza then
    for _, ch in ipairs(tradePlaza:GetChildren()) do
        print(("  [%s] %s — %d children"):format(ch.ClassName, ch.Name, #ch:GetChildren()))
        -- Print sub-children jika menarik
        local nl = ch.Name:lower()
        if nl:find("list") or nl:find("market") or nl:find("sell") or nl:find("item") or nl:find("trade") then
            for _, gc in ipairs(ch:GetChildren()) do
                print(("    [%s] %s"):format(gc.ClassName, gc.Name))
            end
        end
    end
end

-- ──────────────────────────────
-- 5. Cari semua StringValue/NumberValue di bawah Players yang terkait listing
-- ──────────────────────────────
print("\n[5] Data values di Players:")
for _, plr in ipairs(Players:GetPlayers()) do
    local vals = {}
    for _, d in ipairs(plr:GetDescendants()) do
        if d:IsA("StringValue") or d:IsA("NumberValue") or d:IsA("IntValue")
            or d:IsA("BoolValue") or d:IsA("ObjectValue") then
            table.insert(vals, ("  [%s] %s = %s"):format(
                d.ClassName, d:GetFullName():gsub("Players%.",""), tostring(d.Value):sub(1,30)))
        end
    end
    if #vals > 0 then
        print(("[PLR] " .. plr.Name .. " — " .. #vals .. " values:"))
        for _, v in ipairs(vals) do print(v) end
