-- Parse JobId (and PlaceId) from raw id or full command
local function ParseJobId(input)
    if not input or input == "" then return nil, nil end
    input = input:gsub("%s+", " "):match("^%s*(.-)%s*$") -- trim
    -- Try to extract from full command: TeleportToPlaceInstance(placeId, "jobId", ...)
    local placeFromCmd, jobFromCmd = input:match('TeleportToPlaceInstance%s*%(%s*(%d+)%s*,%s*"([^"]+)"')
    if jobFromCmd and jobFromCmd ~= "" then
        return tonumber(placeFromCmd) or game.PlaceId, jobFromCmd
    end
    -- Try raw UUID pattern (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
    local uuid = input:match("([%x]+%-[%x]+%-[%x]+%-[%x]+%-[%x]+)")
    if uuid then return game.PlaceId, uuid end
    -- Fallback: treat entire input as jobId
    if #input > 10 then return game.PlaceId, input end
    return nil, nil
end

local customRetrying = false
local isCustomTPActive = false
local tpFailedConn = nil

CustomGoBtn.MouseButton1Click:Connect(function()
    if isCustomTPActive then return end
    local raw = CustomInput.Text
    local placeId, jobId = ParseJobId(raw)
    if not jobId then
        CTPStatus.Text = "JobId tidak valid!"
        CTPStatus.TextColor3 = COLORS.red
        return
    end
    isCustomTPActive = true
    customRetrying = true
    CustomGoBtn.Text = "..."
    CustomCancelBtn.Visible = true
    CTPStatus.Text = jobId:sub(1, 24)
    CTPStatus.TextColor3 = COLORS.textDim
    if StatusText then StatusText.Text = "Custom teleport..." end

    task.spawn(function()
        local attempt = 0

        -- Disconnect old listener if any
        if tpFailedConn then pcall(function() tpFailedConn:Disconnect() end) end

        while customRetrying do
            attempt = attempt + 1
            CTPStatus.Text = string.format("Attempt #%d - %s", attempt, jobId:sub(1, 14))
            CTPStatus.TextColor3 = COLORS.textDim

            -- Flag to track if teleport failed
            local teleportFailed = false
            local failReason = ""

            -- Listen for TeleportInitFailed
            tpFailedConn = TeleportService.TeleportInitFailed:Connect(function(player, result, errMessage)
                if player == LocalPlayer then
                    teleportFailed = true
                    failReason = tostring(result) .. " " .. tostring(errMessage or "")
                end
            end)

            -- Attempt teleport
            local tpOk, tpErr = pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
            end)

            if not tpOk then
                -- pcall itself errored (invalid args etc)
                CTPStatus.Text = string.format("#%d Error: %s", attempt, tostring(tpErr):sub(1, 20))
                CTPStatus.TextColor3 = COLORS.red
                if tpFailedConn then tpFailedConn:Disconnect(); tpFailedConn = nil end
                task.wait(0.5)
            else
                -- Wait briefly for TeleportInitFailed to fire (if server full etc)
                task.wait(0.5)

                if tpFailedConn then tpFailedConn:Disconnect(); tpFailedConn = nil end

                if teleportFailed then
                    -- Server full or other failure, retry
                    CTPStatus.Text = string.format("#%d Gagal: %s", attempt, failReason:sub(1, 20))
                    CTPStatus.TextColor3 = COLORS.orange
                    if StatusText then StatusText.Text = string.format("Retry #%d...", attempt) end
                    -- Loop continues, will retry after next iteration
                else
                    -- No failure detected = teleport in progress
                    CTPStatus.Text = string.format("Teleporting... (#%d)", attempt)
                    CTPStatus.TextColor3 = COLORS.green
                    if StatusText then StatusText.Text = "Teleport berhasil!" end
                    CustomGoBtn.Text = "OK!"
                    CustomCancelBtn.Visible = false
                    -- Keep retrying in background in case it silently fails
                    task.wait(2)
                    -- If we're still here after 2s, teleport didn't work, retry
                    if not customRetrying then break end
                    CTPStatus.Text = string.format("#%d Masih disini, retry...", attempt)
                    CTPStatus.TextColor3 = COLORS.orange
                end
            end
        end

        if not customRetrying then
            CTPStatus.Text = "Dibatalkan (#" .. attempt .. ")"
            CTPStatus.TextColor3 = COLORS.red
            if StatusText then StatusText.Text = "Custom TP dibatalkan" end
        end
        if tpFailedConn then pcall(function() tpFailedConn:Disconnect() end); tpFailedConn = nil end
        CustomGoBtn.Text = "Teleport"
        CustomCancelBtn.Visible = false
        isCustomTPActive = false
        customRetrying = false
    end)
end)

