-- Server Hop System (based on Infinite Yield pattern)
local function DoServerHop(category, btnRef)
    if isHopping then return end
    isHopping = true
    local origText = btnRef.Text
    btnRef.Text = "..."
    RHPStatus.Text = "Fetching servers..."
    RHPStatus.TextColor3 = COLORS.textDim
    if StatusText then StatusText.Text = "Mencari server " .. category .. "..." end

    task.spawn(function()
        -- Fetch servers (Infinite Yield style - simple, one page)
        if not executor_request then
            RHPStatus.Text = "HTTP tidak tersedia"
            RHPStatus.TextColor3 = COLORS.red
            btnRef.Text = origText
            isHopping = false
            return
        end

        -- Use Asc for sepi/sedang (small servers first), Desc for ramai/random
        local sortOrder = (category == "sepi" or category == "sedang") and "Asc" or "Desc"

        local ok, req = pcall(function()
            return executor_request({
                Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100", game.PlaceId, sortOrder)
            })
        end)

        if not ok or not req then
            RHPStatus.Text = "Gagal fetch server"
            RHPStatus.TextColor3 = COLORS.red
            if StatusText then StatusText.Text = "Fetch server gagal" end
            warn("[SniperUI] req gagal:", ok, tostring(req))
            btnRef.Text = origText
            isHopping = false
            return
        end

        local rawBody = req.Body or req.body or ""
        if rawBody == "" then
            -- Fallback: game:HttpGet
            local httpOk, httpResult = pcall(function()
                return game:HttpGet(string.format(
                    "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s" .. "&" .. "limit=100",
                    game.PlaceId, sortOrder
                ))
            end)
            if httpOk and httpResult then rawBody = httpResult end
        end

        if rawBody == "" then
            RHPStatus.Text = "Body kosong"
            RHPStatus.TextColor3 = COLORS.red
            warn("[SniperUI] Body kosong. StatusCode:", req.StatusCode or req.statuscode or "?")
            btnRef.Text = origText
            isHopping = false
            return
        end

        local decOk, body = pcall(function() return HttpService:JSONDecode(rawBody) end)
        if not decOk or not body or not body.data then
            RHPStatus.Text = "Err: " .. tostring(rawBody):sub(1, 35)
            RHPStatus.TextColor3 = COLORS.red
            warn("[SniperUI] Decode gagal. Body:", tostring(rawBody):sub(1, 300))
            btnRef.Text = origText
            isHopping = false
            return
        end

        -- Collect joinable servers (IY style: playing < maxPlayers, not current server)
        local servers = {}
        for _, v in next, body.data do
            if type(v) == "table" and tonumber(v.playing) and tonumber(v.maxPlayers) and v.playing < v.maxPlayers and v.id ~= game.JobId then
                table.insert(servers, v)
            end
        end

        if #servers == 0 then
            RHPStatus.Text = "Tidak ada server tersedia"
            RHPStatus.TextColor3 = COLORS.red
            btnRef.Text = origText
            isHopping = false
            return
        end

        -- Filter by category
        local maxP = servers[1].maxPlayers or 20
        local highThreshold = math.floor(maxP * 0.7)
        local pool = {}

        if category == "ramai" then
            for _, s in ipairs(servers) do
                if s.playing >= highThreshold then table.insert(pool, s) end
            end
        elseif category == "sepi" then
            for _, s in ipairs(servers) do
                if s.playing == 1 then table.insert(pool, s) end
            end
        elseif category == "sedang" then
            for _, s in ipairs(servers) do
                if s.playing >= 2 and s.playing < highThreshold then table.insert(pool, s) end
            end
        elseif category == "random" then
            pool = servers
        end

        if #pool == 0 then
            if category == "sepi" then
                -- Fallback: ambil server paling sepi yang ada
                table.sort(servers, function(a, b) return a.playing < b.playing end)
                pool = { servers[1] }
                RHPStatus.Text = "Sepi kosong, fallback: " .. servers[1].playing .. " players"
                RHPStatus.TextColor3 = COLORS.orange
            else
                RHPStatus.Text = "Tidak ada server " .. category
                RHPStatus.TextColor3 = COLORS.orange
                btnRef.Text = origText
                isHopping = false
                return
            end
        end

        -- Auto-retry loop (max 5 attempts, 2s delay between retries)
        local MAX_RETRIES = 5
        for attempt = 1, MAX_RETRIES do
            -- Pick random server from pool
            local picked = pool[math.random(1, #pool)]
            RHPInfo.Text = string.format("%d servers | %d/%d players", #servers, picked.playing, picked.maxPlayers)
            RHPStatus.Text = string.format("#%d %s > %d/%d", attempt, category:upper(), picked.playing, picked.maxPlayers)
            RHPStatus.TextColor3 = COLORS.green
            if StatusText then StatusText.Text = string.format("Teleporting #%d (%d players)...", attempt, picked.playing) end
            btnRef.Text = string.format("Go! #%d", attempt)

            -- Teleport directly (IY style)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, picked.id, LocalPlayer)

            -- Wait 3s to see if teleport works
            task.wait(3)

            -- Still here = teleport failed
            if attempt < MAX_RETRIES then
                RHPStatus.Text = string.format("#%d gagal, retry in 2s...", attempt)
                RHPStatus.TextColor3 = COLORS.orange
                if StatusText then StatusText.Text = string.format("Retry #%d in 2s...", attempt + 1) end

                -- Cooldown 2s to avoid 429
                task.wait(2)

                -- Re-fetch servers for next attempt (fresh data, avoids picking same dead server)
                local ok2, req2 = pcall(function()
                    return executor_request({
                        Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100", game.PlaceId, sortOrder)
                    })
                end)
                local rawBody2 = ""
                if ok2 and req2 then rawBody2 = req2.Body or req2.body or "" end
                if rawBody2 ~= "" then
                    local decOk2, body2 = pcall(function() return HttpService:JSONDecode(rawBody2) end)
                    if decOk2 and body2 and body2.data then
                        -- Rebuild server list
                        servers = {}
                        for _, v in next, body2.data do
                            if type(v) == "table" and tonumber(v.playing) and tonumber(v.maxPlayers) and v.playing < v.maxPlayers and v.id ~= game.JobId then
                                table.insert(servers, v)
                            end
                        end
                        if #servers > 0 then
                            -- Re-filter pool
                            pool = {}
                            if category == "ramai" then
                                for _, s in ipairs(servers) do
                                    if s.playing >= highThreshold then table.insert(pool, s) end
                                end
                            elseif category == "sepi" then
                                for _, s in ipairs(servers) do
                                    if s.playing == 1 then table.insert(pool, s) end
                                end
                            elseif category == "sedang" then
                                for _, s in ipairs(servers) do
                                    if s.playing >= 2 and s.playing < highThreshold then table.insert(pool, s) end
                                end
                            else
                                pool = servers
                            end
                            -- Sepi fallback
                            if #pool == 0 and category == "sepi" then
                                table.sort(servers, function(a, b) return a.playing < b.playing end)
                                pool = { servers[1] }
                            end
                            if #pool == 0 then pool = servers end
                        end
                    end
                end
            end
        end

        -- All retries failed
        RHPStatus.Text = string.format("Gagal setelah %d retry", MAX_RETRIES)
        RHPStatus.TextColor3 = COLORS.red
        if StatusText then StatusText.Text = "Server hop gagal, coba lagi nanti" end
        btnRef.Text = origText
        isHopping = false
    end)
end

