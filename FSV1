local isLoading = false
local function LoadListings()
    if isLoading then return end
    if not requireOK then StatusText.Text = "Modules tidak tersedia"; return end
    isLoading = true
    RefreshBtn.Text = "..."; StatusText.Text = "Memuat listing..."
    for _, child in ipairs(Scroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    ShowLoading(true, "Memuat listing dari server...")

    task.spawn(function()
        local success, err = pcall(function()
            local saleListings
            local slOk = pcall(function() saleListings = Replion.Client:WaitReplion("SaleListings") end)
            if not slOk or not saleListings then
                ShowLoading(false); ShowEmpty("Gagal memuat SaleListings.")
                StatusText.Text = "Error: SaleListings timeout"; RefreshBtn.Text = "Refresh"; isLoading = false; return
            end

            local rapReplion; pcall(function() rapReplion = Replion.Client:WaitReplion("RAP") end)
            local allRapData = rapReplion and pcall(function() return rapReplion:Get({"RAPs"}) end) and rapReplion:Get({"RAPs"}) or nil

            local allData = saleListings:Get({"Players"})
            if not allData then
                ShowLoading(false); ShowEmpty("Tidak ada data listing.")
                StatusText.Text = "Selesai (0 items)"; RefreshBtn.Text = "Refresh"; isLoading = false; return
            end

            local playerCount = 0
            for _ in pairs(allData) do playerCount = playerCount + 1 end
            PlayerCountLabel.Text = playerCount .. " booths"

            local entries = {}
            local itemDefCache = {}
            for userIdStr, playerData in pairs(allData) do
                local sellerPlayer = Players:GetPlayerByUserId(tonumber(userIdStr))
                if sellerPlayer == LocalPlayer then continue end
                local sellerName = sellerPlayer and sellerPlayer.DisplayName or ("ID:" .. userIdStr)
                local containers = {}
                if playerData.Booth then table.insert(containers, {source = "Booth", data = playerData.Booth}) end
                if playerData.Sign then table.insert(containers, {source = "Sign", data = playerData.Sign}) end
                for _, container in ipairs(containers) do
                    for listingId, itemData in pairs(container.data) do
                        if not itemData.Item or not itemData.Price then continue end
                        local ck = tostring(itemData.ItemType or "") .. "_" .. tostring(itemData.Item.Id or "")
                        local itemDef = itemDefCache[ck]
                        if itemDef == nil then
                            local dOk, dVal = pcall(function() return ItemUtility.GetItemDataFromItemType(itemData.ItemType, itemData.Item.Id) end)
                            itemDef = dOk and dVal or false; itemDefCache[ck] = itemDef
                        end
                        if itemDef == false then itemDef = nil end
                        local itemName = itemDef and itemDef.Data and itemDef.Data.Name or tostring(itemData.Item.Id)
                        local itemTier = itemDef and itemDef.Data and itemDef.Data.Tier or 0
                        local itemIdStr = itemDef and itemDef.Data and tostring(itemDef.Data.Id) or tostring(itemData.Item.Id)
                        local tierNames = {[1]="Common",[2]="Uncommon",[3]="Rare",[4]="Epic",[5]="Legendary",[6]="Mythic",[7]="Secret"}
                        table.insert(entries, {
                            Seller = sellerPlayer, SellerName = sellerName, ItemName = itemName,
                            ItemType = itemData.ItemType, ItemTier = itemTier, TierName = tierNames[itemTier] or "T"..itemTier,
                            Price = itemData.Price, ListingId = listingId, ItemIdStr = itemIdStr,
                            Source = container.source, RAP = nil, ALP = nil,
                        })
                    end
                end
            end

            StatusText.Text = string.format("%d items. Fetching RAP...", #entries)
            ShowLoading(true, string.format("%d items. Mengambil RAP...", #entries))

            local rapDone, totalItems = 0, #entries
            for i, entry in ipairs(entries) do
                local cachedRap = 0
                if allRapData and entry.ItemType and entry.ItemIdStr then
                    local rk = entry.ItemType .. "/" .. entry.ItemIdStr
                    if allRapData[entry.ItemType] and allRapData[entry.ItemType][rk] then
                        local rv = allRapData[entry.ItemType][rk]
                        if rv and rv ~= -1 then cachedRap = tonumber(rv) or 0 end
                    end
                end
                if cachedRap > 0 then entries[i].RAP = cachedRap; rapDone = rapDone + 1
                else local idx = i; task.spawn(function() entries[idx].RAP = FetchRAPFromServer(entry.ItemType, entry.ItemIdStr) or 0; rapDone = rapDone + 1 end) end
            end
            local t0 = tick()
            while rapDone < totalItems and (tick() - t0) < 5 do task.wait(0.05) end

            allEntries = entries; ShowLoading(false); ApplySortAndFilter()
            local sc = 0; for _, e in ipairs(entries) do if IsSnipe(e.Price, e.RAP) then sc = sc + 1 end end
            StatusText.Text = string.format("%d items | %d snipes", #entries, sc)
        end)
        if not success then
            ShowLoading(false); ShowEmpty("Error: " .. tostring(err))
            StatusText.Text = "Error: " .. tostring(err):sub(1, 50); warn("[SniperUI] Error:", err)
        end
        RefreshBtn.Text = "Refresh"; isLoading = false
    end)
end

